{
  "name": "@typedstandards/web",
  "version": "0.0.0",
  "private": true,
  "description": "typedstandards.org — the Typed Standards site and the client-side record verifier.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build --workspace @typedstandards/verify-core && npm run build --workspace @typedstandards/produce-core",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@typedstandards/verify-core": "^0.14.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@typedstandards/produce-core": "^0.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
